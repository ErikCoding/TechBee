# Copy to .env.local and fill in when connecting Firebase.
# The app runs entirely on mock data until these are set —
# see lib/firebase.ts and services/*.service.ts.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── LiveKit (lesson video rooms) ──
# The app runs against ANY LiveKit deployment — easiest for local dev is a
# free project at https://cloud.livekit.io (no docker needed): create a
# project, copy its URL/API key/secret below. Self-hosting later (e.g.
# `livekit-server --dev`) is a drop-in swap of these same three values.
#
# NEXT_PUBLIC_LIVEKIT_URL must start with wss:// — it's the only one of the
# three exposed to the browser; the app/api/livekit/token route is the only
# place the API key/secret are used, and they never reach the client.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Firebase Admin (optional, server-only) ──
# Lets app/api/livekit/token verify the caller's Firebase ID token and
# cross-check it against the lesson doc's teacherId/studentId server-side,
# so only the two real participants of a lesson can ever get a token for
# its room. Paste the full service-account JSON (Firebase console → Project
# settings → Service accounts → Generate new private key) as ONE line.
# Without this, the token route falls back to trusting the client-supplied
# identity — same posture as every other service in mock mode, and still
# fine for local dev / before Firebase is wired up.
FIREBASE_SERVICE_ACCOUNT_KEY=
