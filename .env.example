# Copy to .env.local and fill in when connecting Firebase.
# The app runs entirely on mock data until these are set —
# see lib/firebase.ts and services/*.service.ts.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Leave false/empty if Firebase Storage is not enabled.
NEXT_PUBLIC_ENABLE_FIREBASE_STORAGE=

# ── LiveKit (lesson video rooms) ──
# The app runs against ANY LiveKit deployment — easiest for local dev is a
# free project at https://cloud.livekit.io (no docker needed): create a
# project, copy its URL/API key/secret below. Self-hosting later (e.g.
# `livekit-server --dev`) is a drop-in swap of these same three values.
#
# NEXT_PUBLIC_LIVEKIT_URL must start with wss:// — it's the only one of the
# three exposed to the browser; the app/api/livekit/token route is the only
# place the API key/secret are used, and they never reach the client.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# No extra config needed for verification — app/api/livekit/token checks
# callers against Google's own Identity Toolkit + Firestore REST APIs using
# the NEXT_PUBLIC_FIREBASE_* values above, so real per-lesson authorization
# works as soon as Firebase is configured, with no service-account key.

# ── Stripe (real payments — Sandbox/Test Mode, see lib/stripe.ts) ──
# Get these from https://dashboard.stripe.com/test/apikeys (make sure the
# dashboard's "Test mode" toggle is ON — top right). Server-only key first,
# never exposed to the browser; the publishable key is the one safe to ship
# client-side (it's used by @stripe/stripe-js if a client-side Elements flow
# is ever added — the current Checkout-redirect flow doesn't even need it,
# but it's included for completeness / future use).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# for local dev, or the Dashboard's Webhooks page once deployed — see the
# "local webhook testing" instructions delivered alongside this integration.
STRIPE_WEBHOOK_SECRET=

# ── Trusted server-side Firestore writes (Stripe webhook + payouts only) ──
# The Stripe webhook has to mark a booking "paid" or a payout "failed" in a
# way nobody can forge from the browser — ordinary firestore.rules trust
# can't provide that, so this one path uses a real Firebase service account
# instead (see lib/firebase-admin.ts for exactly why, and why it's safe from
# the ERR_REQUIRE_ESM bug that made the old firebase-admin usage here get
# removed). Firebase Console → Project settings → Service accounts →
# Generate new private key. Paste the downloaded JSON's contents as ONE
# line here (or base64-encode it first — both are accepted) — NEVER commit
# the actual key to the repo.
FIREBASE_SERVICE_ACCOUNT_KEY=
