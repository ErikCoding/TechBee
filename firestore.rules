rules_version = '2';

// ─────────────────────────────────────────────────────────────
// TechBee — baseline Firestore security rules.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and this project linked via
// `firebase use <project-id>`).
//
// These are a reasonable starting point for the current feature
// set (auth profiles, read-only catalog data, per-user lessons,
// two-party conversations). Review before relying on them for
// anything beyond a demo/beta — in particular, tighten the
// `users` and `lessons` write rules once server-side validation
// (Cloud Functions) exists for things like balances and payouts.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // True if the caller is a parent linked to the given student (see
    // services/family-link.service.ts) — used by the lessons rules below so
    // a parent can read/confirm/dispute reports for their linked student's
    // lessons even on ones they didn't personally pay for.
    function isLinkedParentOf(studentId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('linkedParentIds', []);
    }

    // ── User profiles ──
    // Anyone signed in can read basic profiles (needed to render
    // names/avatars in chat, reviews, etc). Only the owner (or an
    // admin) can write their own doc, and role can only be set at
    // creation time, not self-escalated afterwards.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role in ['student', 'teacher', 'parent'];
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
        // Parent-account linking (see services/family-link.service.ts):
        // redeeming a code has the *parent's* client write onto the
        // *student's* doc to add themselves as a linked parent — not the
        // owner, so it needs its own narrow escape hatch. Field-scoped to
        // `linkedParentIds` only, and the writer must be adding their own
        // uid (not tampering with someone else's link). Same simulation-
        // phase "trust the client" compromise as the teacher-reviews rule
        // below, since there's no trusted backend to broker this instead.
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParentIds'])
          && request.auth.uid in request.resource.data.linkedParentIds);
      allow delete: if isAdmin();
    }

    // ── Public catalog data (read-only from the client) ──
    // Written only via the admin panel's seed action (an
    // authenticated admin) or, later, a proper teacher-editing flow.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Teacher catalog + applications live in the same collection,
    // keyed by the applicant's own Firebase Auth uid.
    // - Public (including signed-out visitors) only ever sees
    //   'approved' profiles, plus legacy demo docs with no `status`
    //   field at all.
    // - An applicant can always see and edit their own doc (to
    //   check their status or re-submit after a rejection), but can
    //   only ever set it back to 'pending' themselves — never
    //   'approved'.
    // - Only an admin can approve/reject (i.e. write any other
    //   status), or edit someone else's doc.
    match /teachers/{teacherId} {
      allow read: if resource == null
        || resource.data.status == 'approved'
        || !('status' in resource.data)
        || isOwner(teacherId)
        || isAdmin();

      allow create: if (
        isOwner(teacherId)
        && request.resource.data.authUserId == teacherId
        && request.resource.data.status == 'pending'
      ) || isAdmin(); // admin also covers the "seed demo data" button, which writes arbitrary catalog ids

      // A student can also update a teacher doc after a completed lesson to
      // leave a review — but only touching `reviews`/`rating`/`reviewCount`,
      // nothing else (see submitLessonReview in lessons.service.ts). This is
      // a simulation-phase compromise (no trusted backend to broker it
      // instead), same as the wallet-write rule below.
      // `stripe` (Connect account id / onboarding+payouts status, see
      // TeacherStripeAccount in lib/types.ts) is never client-writable,
      // full stop — only the trusted server (app/api/stripe/connect/*,
      // the account.updated webhook) writes it, via the admin SDK,
      // which bypasses these rules entirely. This blocks any client
      // (including an admin's own browser) from smuggling a fake
      // `chargesEnabled: true` etc. into an otherwise-legitimate edit.
      // A review write may only touch the three review fields, and must
      // leave the aggregate consistent with the array it ships alongside:
      // `reviewCount` has to equal the number of reviews, the average has
      // to stay in range, and the array can grow by at most one entry per
      // write. That last clause is what stops a client from smuggling a
      // pile of fabricated reviews into a single update — the intended
      // write either edits an existing entry in place (same size) or adds
      // exactly one (size + 1).
      //
      // Uniqueness per (student, teacher) is enforced by the deterministic
      // review id plus the transactional upsert in
      // services/teachers.service.ts, since rules cannot index into an
      // array to prove no two entries share an authorId. Making that
      // guarantee rule-level would require moving reviews into their own
      // subcollection keyed by author — noted as future work rather than
      // done here, because it is a schema migration, not a rules tweak.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripe'])
        && ((isOwner(teacherId) && request.resource.data.status == 'pending')
          || isAdmin()
          || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating', 'reviewCount'])
            // `reviewCount` counts distinct reviewers, so it can legitimately
            // be lower than the array length while legacy duplicate rows
            // (written before the one-review-per-pair rule) are still present
            // — hence <=, not ==. It may never exceed it.
            && request.resource.data.reviewCount <= request.resource.data.reviews.size()
            && request.resource.data.reviews.size() <= resource.data.reviews.size() + 1
            && request.resource.data.rating >= 0
            && request.resource.data.rating <= 5));

      allow delete: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Lessons / bookings ──
    // A student (or a linked parent booking/paying on their behalf — see
    // Lesson.payerId in lib/types.ts and services/family-link.service.ts)
    // can create a booking; the student, the payer, any signed-in teacher,
    // an admin, or the student's linked parent(s) can read/update it.
    //
    // Note: lessons are matched to a teacher by the static teacher
    // *catalog* id (e.g. "1"), not that teacher's real Firebase Auth
    // uid — those two aren't linked 1:1 yet (see
    // services/lessons.service.ts: resolveTeacherCatalogId). Until
    // they are, we can't restrict reads to "this exact teacher's own
    // lessons" at the rules level, so any signed-in teacher account
    // can read lesson records. Tighten this once teacher accounts
    // store their catalog id so `resource.data.teacherId ==
    // <that field>` can be checked directly.
    // A lesson moves through pending → upcoming → completed/cancelled, and
    // can carry a `pendingChange` (cancel/reschedule request) or (once
    // completed) a `report`/`dispute` (see services/lessons.service.ts).
    // The student, the payer, the teacher, and — since a parent needs to
    // see and confirm/dispute reports for lessons they didn't necessarily
    // pay for themselves — the student's linked parent(s) all need update
    // access. Same catalog-id-vs-real-uid caveat as the read rule above
    // applies to `isTeacher()` here too.
    match /lessons/{id} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        isLinkedParentOf(resource.data.studentId)
      );
      // No client `create` rule — a lesson doc only ever comes into
      // existence once the Stripe webhook confirms a real successful
      // payment (see app/api/stripe/webhook/route.ts), written via the
      // trusted admin SDK, which bypasses these rules entirely. This
      // used to allow the student/payer to create a booking directly;
      // now that booking creation IS payment confirmation, letting the
      // client do it would mean anyone could write themselves a "paid"
      // lesson for free.
      allow create: if false;
      // Payment-integrity fields (see the "Stripe payment" block on
      // Lesson in lib/types.ts) are never client-writable — only the
      // trusted server (the webhook, the payout/transfer/refund
      // endpoints) sets them, via the admin SDK. Everything else on a
      // lesson (status, pendingChange, report, dispute, ...) keeps the
      // existing client-write posture.
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        isLinkedParentOf(resource.data.studentId)
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus', 'priceGrosze', 'platformFeeGrosze', 'teacherAmountGrosze',
        'stripeCheckoutSessionId', 'stripePaymentIntentId', 'stripeTransferId', 'stripeRefundId'
      ]);
      allow delete: if isAdmin();
    }

    // A student generates a short-lived single-use code so a parent can
    // link their account (see services/family-link.service.ts). Anyone
    // signed in can read a code by its id to redeem it (they don't know
    // the student's uid up front); only the student themselves can create
    // one; redeeming can only ever set `usedByParentId`/`usedAt`, only
    // once, and only by the parent claiming it.
    match /linkCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn()
        && !('usedByParentId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByParentId', 'usedAt'])
        && request.resource.data.usedByParentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Messaging ──
    // Only the two participants of a conversation can read/write it
    // or its messages.
    match /conversations/{conversationId} {
      // `resource == null` covers the "does this conversation exist yet?"
      // getDoc a client does before creating one — without it, reading a
      // not-yet-created conversation throws instead of just returning
      // "not found", which broke starting a first-time chat.
      allow read, update: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      // Admin-only — used by the "reset activity data" button (see
      // services/reset.service.ts) to wipe messaging before launch.
      allow delete: if isAdmin();

      match /items/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        // Report-card messages (see services/chat.service.ts
        // updateReportCardStatus) get their `reportCard.status` flipped
        // live by whoever confirms/disputes it, by an admin resolving a
        // dispute, or by anyone's browser lazily auto-confirming an
        // overdue report — any conversation participant or admin, and
        // only that one nested field.
        allow update: if (isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCard'])) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── Legacy BeeCoins wallet collections (unused) ──
    // The old Firestore-simulated student/teacher wallet (top-up,
    // withdraw, lesson-payment "transfer") was removed once real Stripe
    // payments landed — students never had real money to begin with,
    // and the teacher wallet now reads live from Stripe (see
    // app/api/stripe/wallet/route.ts), never from a Firestore balance.
    // Left deny-all (rather than deleted) purely so any leftover local
    // data from before this migration stays readable by nobody but an
    // admin doing cleanup, instead of silently reopening a write path
    // nothing in the app uses anymore.
    match /wallets/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /walletTransactions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── BeePoints, notifications ──
    match /beepoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /beepointsEvents/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can create a notification — not just for
      // themselves. This is what lets a student's booking action create a
      // notification for the teacher, and an admin's approve/reject action
      // create one for the applicant, without needing a trusted backend.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      // The owner can delete their own notification (see the delete
      // button in components/dashboard/notifications-panel.tsx) — no
      // money/security implication either way, unlike most other
      // owner-delete rules in this file, so this doesn't need to be
      // admin-only like the reset-data button's bulk delete is.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Stripe payouts (see PayoutRecord in lib/types.ts) ──
    // Written only by the trusted server (app/api/stripe/payout, the
    // payout.paid/payout.failed webhook handlers), which bypasses these
    // rules via the admin SDK — no client write path at all. A teacher
    // can read their own payout history; admins can read everyone's.
    match /payouts/{id} {
      allow read: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Stripe webhook idempotency ledger ──
    // One doc per processed Stripe event id (see
    // app/api/stripe/webhook/route.ts) — purely an internal dedupe
    // record, never read or written by any client.
    match /stripeEvents/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
