rules_version = '2';

// ─────────────────────────────────────────────────────────────
// TechBee — baseline Firestore security rules.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and this project linked via
// `firebase use <project-id>`).
//
// These are a reasonable starting point for the current feature
// set (auth profiles, read-only catalog data, per-user lessons,
// two-party conversations). Review before relying on them for
// anything beyond a demo/beta — in particular, tighten the
// `users` and `lessons` write rules once server-side validation
// (Cloud Functions) exists for things like balances and payouts.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // True if the caller is a parent linked to the given student (see
    // services/family-link.service.ts) — used by the lessons rules below so
    // a parent can read/confirm/dispute reports for their linked student's
    // lessons even on ones they didn't personally pay for.
    function isLinkedParentOf(studentId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('linkedParentIds', []);
    }

    // ── User profiles ──
    // Anyone signed in can read basic profiles (needed to render
    // names/avatars in chat, reviews, etc). Only the owner (or an
    // admin) can write their own doc, and role can only be set at
    // creation time, not self-escalated afterwards.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role in ['student', 'teacher', 'parent'];
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
        // Parent-account linking (see services/family-link.service.ts):
        // redeeming a code has the *parent's* client write onto the
        // *student's* doc to add themselves as a linked parent — not the
        // owner, so it needs its own narrow escape hatch. Field-scoped to
        // `linkedParentIds` only, and the writer must be adding their own
        // uid (not tampering with someone else's link). Same simulation-
        // phase "trust the client" compromise as the teacher-reviews rule
        // below, since there's no trusted backend to broker this instead.
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParentIds'])
          && request.auth.uid in request.resource.data.linkedParentIds);
      allow delete: if isAdmin();
    }

    // ── Public catalog data (read-only from the client) ──
    // Written only via the admin panel's seed action (an
    // authenticated admin) or, later, a proper teacher-editing flow.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Teacher catalog + applications live in the same collection,
    // keyed by the applicant's own Firebase Auth uid.
    // - Public (including signed-out visitors) only ever sees
    //   'approved' profiles, plus legacy demo docs with no `status`
    //   field at all.
    // - An applicant can always see and edit their own doc (to
    //   check their status or re-submit after a rejection), but can
    //   only ever set it back to 'pending' themselves — never
    //   'approved'.
    // - Only an admin can approve/reject (i.e. write any other
    //   status), or edit someone else's doc.
    match /teachers/{teacherId} {
      allow read: if resource == null
        || resource.data.status == 'approved'
        || !('status' in resource.data)
        || isOwner(teacherId)
        || isAdmin();

      allow create: if (
        isOwner(teacherId)
        && request.resource.data.authUserId == teacherId
        && request.resource.data.status == 'pending'
      ) || isAdmin(); // admin also covers the "seed demo data" button, which writes arbitrary catalog ids

      // A student can also update a teacher doc after a completed lesson to
      // leave a review — but only touching `reviews`/`rating`/`reviewCount`,
      // nothing else (see submitLessonReview in lessons.service.ts). This is
      // a simulation-phase compromise (no trusted backend to broker it
      // instead), same as the wallet-write rule below.
      allow update: if (isOwner(teacherId) && request.resource.data.status == 'pending')
        || isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating', 'reviewCount']));

      allow delete: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Lessons / bookings ──
    // A student (or a linked parent booking/paying on their behalf — see
    // Lesson.payerId in lib/types.ts and services/family-link.service.ts)
    // can create a booking; the student, the payer, any signed-in teacher,
    // an admin, or the student's linked parent(s) can read/update it.
    //
    // Note: lessons are matched to a teacher by the static teacher
    // *catalog* id (e.g. "1"), not that teacher's real Firebase Auth
    // uid — those two aren't linked 1:1 yet (see
    // services/lessons.service.ts: resolveTeacherCatalogId). Until
    // they are, we can't restrict reads to "this exact teacher's own
    // lessons" at the rules level, so any signed-in teacher account
    // can read lesson records. Tighten this once teacher accounts
    // store their catalog id so `resource.data.teacherId ==
    // <that field>` can be checked directly.
    // A lesson moves through pending → upcoming → completed/cancelled, and
    // can carry a `pendingChange` (cancel/reschedule request) or (once
    // completed) a `report`/`dispute` (see services/lessons.service.ts).
    // The student, the payer, the teacher, and — since a parent needs to
    // see and confirm/dispute reports for lessons they didn't necessarily
    // pay for themselves — the student's linked parent(s) all need update
    // access. Same catalog-id-vs-real-uid caveat as the read rule above
    // applies to `isTeacher()` here too.
    match /lessons/{id} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        isLinkedParentOf(resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.payerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        isTeacher() ||
        isAdmin() ||
        isLinkedParentOf(resource.data.studentId)
      );
      allow delete: if isAdmin();
    }

    // A student generates a short-lived single-use code so a parent can
    // link their account (see services/family-link.service.ts). Anyone
    // signed in can read a code by its id to redeem it (they don't know
    // the student's uid up front); only the student themselves can create
    // one; redeeming can only ever set `usedByParentId`/`usedAt`, only
    // once, and only by the parent claiming it.
    match /linkCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn()
        && !('usedByParentId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByParentId', 'usedAt'])
        && request.resource.data.usedByParentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Messaging ──
    // Only the two participants of a conversation can read/write it
    // or its messages.
    match /conversations/{conversationId} {
      // `resource == null` covers the "does this conversation exist yet?"
      // getDoc a client does before creating one — without it, reading a
      // not-yet-created conversation throws instead of just returning
      // "not found", which broke starting a first-time chat.
      allow read, update: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      // Admin-only — used by the "reset activity data" button (see
      // services/reset.service.ts) to wipe messaging before launch.
      allow delete: if isAdmin();

      match /items/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // ── Wallet, BeePoints, notifications ──
    // Scoped to the owning user; balances should ultimately only be
    // mutated by a trusted backend (Cloud Function) once real money
    // is involved — this rule is a placeholder for the demo phase.
    // Wallet top-up/withdrawal/lesson-payment-transfer is an intentional
    // simulation (no real payment processor) — but a *working* one, so
    // balances genuinely change. Booking a lesson moves the price from the
    // student's wallet to the teacher's, which means a student's client
    // needs to write to the teacher's wallet doc too — there's no trusted
    // backend to broker that yet, so any signed-in user can write here.
    // Tighten this (route writes through a Cloud Function) before this
    // involves real money.
    match /wallets/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /walletTransactions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      // Escrow holds (see holdLessonPayment in wallet.service.ts) get
      // flipped from 'pending' to 'completed'/'failed' by whoever's
      // browser happens to trigger the release/refund/auto-confirm — not
      // necessarily the transaction's own owner (e.g. a teacher's dashboard
      // load can lazily auto-confirm an overdue report and release a
      // student's held payment). Same demo-phase "trust the client, no
      // backend to broker it" compromise as the wallet doc rule above.
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /beepoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /beepointsEvents/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can create a notification — not just for
      // themselves. This is what lets a student's booking action create a
      // notification for the teacher, and an admin's approve/reject action
      // create one for the applicant, without needing a trusted backend.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
