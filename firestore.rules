rules_version = '2';

// ─────────────────────────────────────────────────────────────
// TechBee — baseline Firestore security rules.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and this project linked via
// `firebase use <project-id>`).
//
// These are a reasonable starting point for the current feature
// set (auth profiles, read-only catalog data, per-user lessons,
// two-party conversations). Review before relying on them for
// anything beyond a demo/beta — in particular, tighten the
// `users` and `lessons` write rules once server-side validation
// (Cloud Functions) exists for things like balances and payouts.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // ── User profiles ──
    // Anyone signed in can read basic profiles (needed to render
    // names/avatars in chat, reviews, etc). Only the owner (or an
    // admin) can write their own doc, and role can only be set at
    // creation time, not self-escalated afterwards.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role in ['student', 'teacher'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // ── Public catalog data (read-only from the client) ──
    // Written only via the admin panel's seed action (an
    // authenticated admin) or, later, a proper teacher-editing flow.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Teacher catalog + applications live in the same collection,
    // keyed by the applicant's own Firebase Auth uid.
    // - Public (including signed-out visitors) only ever sees
    //   'approved' profiles, plus legacy demo docs with no `status`
    //   field at all.
    // - An applicant can always see and edit their own doc (to
    //   check their status or re-submit after a rejection), but can
    //   only ever set it back to 'pending' themselves — never
    //   'approved'.
    // - Only an admin can approve/reject (i.e. write any other
    //   status), or edit someone else's doc.
    match /teachers/{teacherId} {
      allow read: if resource == null
        || resource.data.status == 'approved'
        || !('status' in resource.data)
        || isOwner(teacherId)
        || isAdmin();

      allow create: if (
        isOwner(teacherId)
        && request.resource.data.authUserId == teacherId
        && request.resource.data.status == 'pending'
      ) || isAdmin(); // admin also covers the "seed demo data" button, which writes arbitrary catalog ids

      allow update: if (isOwner(teacherId) && request.resource.data.status == 'pending') || isAdmin();

      allow delete: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Lessons / bookings ──
    // A student can create a booking for themselves; the booking
    // student, any signed-in teacher, or an admin can read it.
    //
    // Note: lessons are matched to a teacher by the static teacher
    // *catalog* id (e.g. "1"), not that teacher's real Firebase Auth
    // uid — those two aren't linked 1:1 yet (see
    // services/lessons.service.ts: resolveTeacherCatalogId). Until
    // they are, we can't restrict reads to "this exact teacher's own
    // lessons" at the rules level, so any signed-in teacher account
    // can read lesson records. Tighten this once teacher accounts
    // store their catalog id so `resource.data.teacherId ==
    // <that field>` can be checked directly.
    // A lesson moves through pending → upcoming → completed/cancelled, and
    // can carry a `pendingChange` (cancel/reschedule request). Both the
    // student and the teacher need to be able to update it — the student to
    // create it or request a change, the teacher to accept/reject a
    // booking, accept/reject a change request, or mark it completed
    // (whoever ends the call first). Same catalog-id-vs-real-uid caveat as
    // the read rule above applies to `isTeacher()` here too.
    match /lessons/{id} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isTeacher() || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Messaging ──
    // Only the two participants of a conversation can read/write it
    // or its messages.
    match /conversations/{conversationId} {
      // `resource == null` covers the "does this conversation exist yet?"
      // getDoc a client does before creating one — without it, reading a
      // not-yet-created conversation throws instead of just returning
      // "not found", which broke starting a first-time chat.
      allow read, update: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

      match /items/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // ── Wallet, BeePoints, notifications ──
    // Scoped to the owning user; balances should ultimately only be
    // mutated by a trusted backend (Cloud Function) once real money
    // is involved — this rule is a placeholder for the demo phase.
    // Wallet top-up/withdrawal/lesson-payment-transfer is an intentional
    // simulation (no real payment processor) — but a *working* one, so
    // balances genuinely change. Booking a lesson moves the price from the
    // student's wallet to the teacher's, which means a student's client
    // needs to write to the teacher's wallet doc too — there's no trusted
    // backend to broker that yet, so any signed-in user can write here.
    // Tighten this (route writes through a Cloud Function) before this
    // involves real money.
    match /wallets/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /walletTransactions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /beepoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /beepointsEvents/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can create a notification — not just for
      // themselves. This is what lets a student's booking action create a
      // notification for the teacher, and an admin's approve/reject action
      // create one for the applicant, without needing a trusted backend.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
