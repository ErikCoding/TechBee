rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null
        && (
          !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'active') != 'deactivated'
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /chat-attachments/{userId}/{conversationId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      // `resource == null` makes "never overwrite an existing attachment"
      // explicit: the Storage emulator evaluates every upload (including an
      // overwrite) as `create`, so relying on `update: false` alone is not
      // enough to keep behaviour identical everywhere.
      allow create: if resource == null
        && isOwner(userId)
        && isConversationParticipant(conversationId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('(image|application/pdf|application/zip|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-.*|text/plain).*');
      allow update: if false;
      allow delete: if isOwner(userId) && isConversationParticipant(conversationId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
