rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /chat-attachments/{userId}/{conversationId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow create: if isOwner(userId)
        && isConversationParticipant(conversationId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('(image|application/pdf|application/zip|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-.*|text/plain).*');
      allow update: if false;
      allow delete: if isOwner(userId) && isConversationParticipant(conversationId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
